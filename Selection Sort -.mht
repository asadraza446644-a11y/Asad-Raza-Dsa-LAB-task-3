.eael-contact-form-align-center, .elementor-widget-eael-weform.eael-contact-form-align-center .eael-weform-container { float: none; margin: 0px auto; display: inline-block; text-align: left; }

.eael-contact-form-align-right, .elementor-widget-eael-weform.eael-contact-form-align-right .eael-weform-container { margin: 0px 0px 0px auto; display: inline-block; text-align: left; }

